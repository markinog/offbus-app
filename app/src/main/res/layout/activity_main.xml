<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_page">

    <!-- ── Header ───────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bg_surface"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="OffBus"
            android:textColor="@color/accent_red"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Campinas · offline"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- ── Painel de controles (busca + botões) ──────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bg_surface"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <!-- Barra de busca -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:background="@drawable/bg_search"
                android:hint="Número ou nome da linha"
                android:textColorHint="@color/text_secondary"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:imeOptions="actionSearch" />

            <ImageButton
                android:id="@+id/btnSearch"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:src="@android:drawable/ic_menu_search"
                android:background="@drawable/bg_btn_red"
                android:contentDescription="Buscar"
                app:tint="@color/white" />
        </LinearLayout>

        <!-- ── Resultados da busca ───────────────────────────────── -->
        <!--
          Aparece enquanto o usuário digita e some ao escolher uma linha.
          A altura é definida em MainActivity.mostrarSugestoes(), limitada a
          MAX_SUGESTOES_VISIVEIS itens para não engolir o mapa; o excedente
          fica acessível pela rolagem.
        -->
        <ScrollView
            android:id="@+id/scrollSugestoes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_sugestoes"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/containerSugestoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </ScrollView>

        <!-- Botões de sentido -->
        <LinearLayout
            android:id="@+id/layoutSentido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <Button
                android:id="@+id/btnSentido1"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="↑ Ida"
                android:textSize="13sp"/>

            <Button
                android:id="@+id/btnSentido2"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="↓ Volta"
                android:textSize="13sp"/>
        </LinearLayout>

        <!-- Botão de itinerários -->
        <Button
            android:id="@+id/btnItinerarios"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:text="Ver itinerários e horários"
            android:textSize="13sp"
            android:textColorHint="@color/bg_input"
            android:backgroundTint="@color/text_secondary"
            android:strokeColor="@color/btn_outline"
            android:visibility="gone"/>

    </LinearLayout>

    <!-- Linha separadora -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"/>

    <!-- ── Dica inicial ──────────────────────────────────────────── -->
    <!-- Ocupa o espaço do mapa enquanto nenhuma linha foi buscada -->
    <TextView
        android:id="@+id/tvDicaBusca"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:text="Digite o número da linha na barra de pesquisa para visualizar o trajeto"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:lineSpacingExtra="4dp"/>

    <!-- ── Mapa ──────────────────────────────────────────────────── -->
    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone"/>

</LinearLayout>
